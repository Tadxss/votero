# Copy to .env.local and fill in with your local `supabase start` output (ANON_KEY/API_URL), or
# your hosted project's URL/anon key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional — error monitoring (see docs/ARCHITECTURE.md). Leave unset for local dev; Sentry.init()
# with no DSN is a safe no-op. The DSN isn't a secret (it's a public ingest endpoint identifier,
# hence NEXT_PUBLIC_) — the other three are build-time-only and needed solely for uploading
# readable (un-minified) source maps to Sentry, not for error capture itself.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
