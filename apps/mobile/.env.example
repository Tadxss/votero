# Copy to .env and fill in with your local `supabase start` output (ANON_KEY/API_URL), or your
# hosted project's URL/anon key.
# NOTE: 127.0.0.1 only works for the web build and simulators/emulators on the same machine — a
# physical device running Expo Go needs your machine's LAN IP instead (e.g. 192.168.x.x:54321).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
